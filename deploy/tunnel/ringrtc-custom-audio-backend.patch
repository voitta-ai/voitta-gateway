+/// A safe handle to WebRTC's audio transport, handed to a [`CustomAudioDevice`].
+///
+/// Holds the opaque callback value WebRTC registers through
+/// `SetCallbackIndirect` and exposes only safe PCM exchange. Until WebRTC has
+/// registered it, playout yields no samples and recorded audio is dropped.
+/// Cloning yields another handle to the same transport.
+#[derive(Clone)]
+pub struct AudioTransport {
+    inner: Arc<Mutex<Option<usize>>>,
+}
+
+impl AudioTransport {
+    fn callback(&self) -> Option<usize> {
+        self.inner.lock().ok().and_then(|guard| *guard)
+    }
+
+    /// Pull up to `samples` frames of playout audio (audio *received* from the
+    /// remote peer) from WebRTC. The returned vector may be shorter than
+    /// `samples` (including empty) when WebRTC has nothing to play.
+    pub fn pull_playout(&self, samples: usize, channels: u32, samples_per_sec: u32) -> Vec<i16> {
+        match self.callback() {
+            Some(callback) => {
+                Worker::need_more_play_data(callback, samples, channels, samples_per_sec).data
+            }
+            None => Vec::new(),
+        }
+    }
+
+    /// Hand recorded audio (audio to *send* to the remote peer) to WebRTC.
+    pub fn push_recording(
+        &self,
+        samples: Vec<i16>,
+        channels: u32,
+        samples_per_sec: u32,
+        total_delay: Duration,
+    ) {
+        if let Some(callback) = self.callback() {
+            Worker::recorded_data_is_available(
+                callback,
+                samples,
+                channels,
+                samples_per_sec,
+                total_delay,
+                0,
+                0,
+                false,
+                None,
+            );
+        }
+    }
+}
+
+/// Lifecycle transitions delivered to a [`CustomAudioDevice`] by WebRTC.
+#[non_exhaustive]
+#[derive(Clone, Copy, Debug)]
+pub enum AudioControlEvent {
+    /// WebRTC wants playout to begin; start pulling via [`AudioTransport`].
+    StartPlayout,
+    /// WebRTC wants playout to stop.
+    StopPlayout,
+    /// WebRTC wants recording to begin. When `send_to_webrtc` is false the
+    /// engine is warming up and captured audio should be discarded rather than
+    /// pushed via [`AudioTransport`].
+    StartRecording { send_to_webrtc: bool },
+    /// WebRTC wants recording to stop.
+    StopRecording,
+    /// The module is shutting down; `run` must return promptly.
+    Terminate,
+}
+
+/// The control channel a [`CustomAudioDevice`] uses to observe playout/record
+/// lifecycle transitions.
+pub struct AudioControl {
+    receiver: mpsc::Receiver<AudioControlEvent>,
+}
+
+impl AudioControl {
+    /// Block until the next event. Returns `None` once the module is gone,
+    /// which must be treated the same as [`AudioControlEvent::Terminate`].
+    pub fn recv(&self) -> Option<AudioControlEvent> {
+        self.receiver.recv().ok()
+    }
+
+    /// Return the next event if one is immediately available, without blocking.
+    pub fn try_recv(&self) -> Option<AudioControlEvent> {
+        self.receiver.try_recv().ok()
+    }
+}
+
+/// An external audio backend that exchanges PCM with WebRTC in place of the
+/// built-in cubeb device, selected via [`AudioBackend::Custom`].
+///
+/// The implementor owns its audio loop: it observes lifecycle transitions from
+/// [`AudioControl`] and exchanges PCM windows with WebRTC through
+/// [`AudioTransport`], returning from `run` only after observing
+/// [`AudioControlEvent::Terminate`] (or `AudioControl::recv` yielding `None`).
+///
+/// The device chooses its own PCM format by passing the desired channel count
+/// and sample rate to the [`AudioTransport`] methods; WebRTC resamples as
+/// needed.
+pub trait CustomAudioDevice: Send + Sync {
+    /// Name reported through device enumeration. A single synthetic input and
+    /// output device with this name is exposed.
+    fn device_name(&self) -> String;
+
+    /// Fixed playout delay (ms) reported to WebRTC's timing logic.
+    fn playout_delay_ms(&self) -> u16 {
+        10
+    }
+
+    /// Run the device's audio loop until `control` yields `Terminate`/`None`.
+    fn run(&self, transport: AudioTransport, control: AudioControl);
+}
+
+/// Spawn the module-side worker thread for a [`CustomAudioDevice`].
+///
+/// Mirrors [`Worker::spawn`]'s contract (device-name reporting, start
+/// signaling, playout-delay replies) but delegates all audio I/O to `device`,
+/// translating the internal [`Event`] stream into safe [`AudioControlEvent`]s.
+fn spawn_custom_worker(
+    device: Arc<dyn CustomAudioDevice>,
+    started_signal: mpsc::Sender<Option<String>>,
+    receiver: mpsc::Receiver<Event>,
+    playout_delay_sender: mpsc::Sender<anyhow::Result<u16>>,
+    input_device_names: Arc<Mutex<AudioDeviceList>>,
+    output_device_names: Arc<Mutex<AudioDeviceList>>,
+) -> JoinHandle<()> {
+    thread::spawn(move || {
+        let name = device.device_name();
+        let playout_delay_ms = device.playout_delay_ms();
+
+        // Expose exactly one synthetic device so enumeration succeeds.
+        let audio_device = AudioDevice {
+            name: name.clone(),
+            unique_id: name.clone(),
+        };
+        if let Ok(mut names) = input_device_names.lock() {
+            names.list = vec![audio_device.clone()];
+        }
+        if let Ok(mut names) = output_device_names.lock() {
+            names.list = vec![audio_device];
+        }
+
+        // The opaque callback WebRTC registers via SetCallbackIndirect.
+        let callback = Arc::new(Mutex::new(None));
+        let (control_sender, control_receiver) = mpsc::channel();
+
+        // Run the device's audio loop on its own thread.
+        let driver = {
+            let transport = AudioTransport {
+                inner: callback.clone(),
+            };
+            let control = AudioControl {
+                receiver: control_receiver,
+            };
+            let device = device.clone();
+            thread::spawn(move || device.run(transport, control))
+        };
+
+        if let Err(e) = started_signal.send(Some(name)) {
+            error!("custom ADM: failed to signal start: {}", e);
+        }
+
+        for received in receiver {
+            match received {
+                Event::SetCallbackIndirect(opaque_callback_data) => {
+                    if let Ok(mut guard) = callback.lock() {
+                        *guard = Some(opaque_callback_data);
+                    }
+                }
+                Event::StartPlayout => {
+                    let _ = control_sender.send(AudioControlEvent::StartPlayout);
+                }
+                Event::StopPlayout => {
+                    let _ = control_sender.send(AudioControlEvent::StopPlayout);
+                }
+                Event::StartRecording => {
+                    let _ = control_sender.send(AudioControlEvent::StartRecording {
+                        send_to_webrtc: true,
+                    });
+                }
+                Event::WarmupRecording(_) => {
+                    let _ = control_sender.send(AudioControlEvent::StartRecording {
+                        send_to_webrtc: false,
+                    });
+                }
+                Event::StopRecording => {
+                    let _ = control_sender.send(AudioControlEvent::StopRecording);
+                }
+                Event::PlayoutDelay => {
+                    if let Err(e) = playout_delay_sender.send(Ok(playout_delay_ms)) {
+                        warn!("custom ADM: failed to send playout delay: {}", e);
+                    }
+                }
+                Event::Terminate => {
+                    let _ = control_sender.send(AudioControlEvent::Terminate);
+                    break;
+                }
+                // The remaining events are cubeb device-management concerns
+                // (device selection, input processing, observers) that have no
+                // meaning for a custom backend.
+                _ => {}
+            }
+        }
+
+        // Make sure the device stops even if the event channel closed without a
+        // Terminate, then wait for its loop to unwind.
+        let _ = control_sender.send(AudioControlEvent::Terminate);
+        drop(control_sender);
+        if let Err(e) = driver.join() {
+            error!("custom ADM: device thread join failed: {:?}", e);
+        }
+    })
+}
